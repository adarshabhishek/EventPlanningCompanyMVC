@model EventPlanningCompanyDAL.Models.Event

@{
    ViewData["Title"] = "Delete";
}

<h2>Delete Event</h2>

<hr />

<h5 class="text-danger">
    Are you sure you want to delete this event?
</h5>

<dl class="row">

    <dt class="col-sm-2">
        Name
    </dt>

    <dd class="col-sm-10">
        @Model.Name
    </dd>

    <dt class="col-sm-2">
        Date
    </dt>

    <dd class="col-sm-10">
        @Model.Date.ToShortDateString()
    </dd>

    <dt class="col-sm-2">
        Location
    </dt>

    <dd class="col-sm-10">
        @Model.Location
    </dd>

    <dt class="col-sm-2">
        Type
    </dt>

    <dd class="col-sm-10">
        @Model.Type
    </dd>

    <dt class="col-sm-2">
        Budget
    </dt>

    <dd class="col-sm-10">
        ₹ @Model.Budget
    </dd>

</dl>

<form method="post" asp-action="Delete">

    <input type="hidden" asp-for="EventId" />

    <input type="submit"
           value="Delete"
           class="btn btn-danger" />

    <a asp-action="Index"
           class="btn btn-secondary">
        Back To List
    </a>

</form>