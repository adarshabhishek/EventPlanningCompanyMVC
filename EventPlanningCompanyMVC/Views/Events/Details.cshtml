@model EventPlanningCompanyDAL.Models.Event

@{
    ViewData["Title"] = "Details";
}

<h2>Event Details</h2>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        Name
    </dt>

    <dd class="col-sm-10">
        @Model.Name
    </dd>

    <dt class="col-sm-2">
        Date
    </dt>

    <dd class="col-sm-10">
        @Model.Date.ToShortDateString()
    </dd>

    <dt class="col-sm-2">
        Location
    </dt>

    <dd class="col-sm-10">
        @Model.Location
    </dd>

    <dt class="col-sm-2">
        Type
    </dt>

    <dd class="col-sm-10">
        @Model.Type
    </dd>

    <dt class="col-sm-2">
        Budget
    </dt>

    <dd class="col-sm-10">
        ₹ @Model.Budget
    </dd>

</dl>

<a asp-action="Edit"
       asp-route-id="@Model.EventId"
       class="btn btn-warning">
    Edit
</a>

<a asp-action="Index"
       class="btn btn-secondary">
    Back To List
</a>